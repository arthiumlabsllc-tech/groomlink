NODE_ENV=development
PORT=3000

# Database
DATABASE_URL="postgresql://groomlink:groomlink123@localhost:5432/groomlink"

# Database Connection Pool (Production Tuning)
DB_CONNECTION_POOL_SIZE=20
DB_CONNECTION_TIMEOUT=10000
DB_IDLE_TIMEOUT=30000

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Mock OTP (for development)
MOCK_OTP="123456"

# App Review demo OTP bypass (production). Lets Apple's App Review sign in
# with a fixed code for one demo phone number; no SMS is sent for it.
# Set DEMO_OTP_ENABLED=false (or unset) after the review is complete.
DEMO_OTP_ENABLED=false
DEMO_PHONE_NUMBER="+233240000000"
DEMO_OTP_CODE="123456"

# Africa's Talking SMS
AT_USERNAME=sandbox
AT_API_KEY=your_api_key_here
SMS_FROM=GroomLink

# Email (Hostinger SMTP)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=no-reply@groomlinkgh.com
SMTP_PASSWORD=your_email_password
EMAIL_FROM=GroomLink <no-reply@groomlinkgh.com>

# CORS
CORS_ORIGIN="http://localhost:5173,http://localhost:8081"

# Booking Engine
BOOKING_BUFFER_MINUTES=15
CANCELLATION_GRACE_HOURS=3
MAX_BOOKING_DAYS_AHEAD=30
HOLD_DURATION_SECONDS=600
AUTO_CANCEL_UNPAID_MINUTES=30
RESCHEDULE_FEE_GHES=5
RESCHEDULE_FEE_WINDOW_HOURS=24

# Google Maps
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Hubtel Payment
HUBTEL_API_ID=your_hubtel_api_id
HUBTEL_API_SECRET=your_hubtel_api_secret
HUBTEL_MERCHANT_ACCOUNT_ID=your_hubtel_merchant_account_id
HUBTEL_PAYMENT_WEBHOOK_URL=https://groomlinkgh.com/api/payments/webhook/hubtel

# Paystack Payment Gateway
PAYSTACK_PUBLIC_KEY=your_paystack_public_key
PAYSTACK_SECRET_KEY=your_paystack_secret_key
PAYSTACK_CALLBACK_URL=https://groomlinkgh.com/api/payments/callback/paystack

# OpenAI (AI Accountant in the admin panel)
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
