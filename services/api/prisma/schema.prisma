// ------------------------------------------------------------
// Security event log (the "security bot" pipeline).
// Every suspected attack / anomaly is written here, then the
// alert service broadcasts it to admins via WebSocket and
// emails HIGH/CRITICAL events.
// ------------------------------------------------------------
model SecurityEvent {
  id          String   @id @default(cuid())
  eventType   String   @map("event_type") // e.g. BRUTE_FORCE_LOGIN, OTP_BOMB, ROLE_ESCALATION, ...
  severity    String   // LOW | MEDIUM | HIGH | CRITICAL
  source      String   @default("app") // app | rate-limit | webhook | middleware | scheduler
  ipAddress   String?  @map("ip_address")
  userId      String?  @map("user_id")
  userEmail   String?  @map("user_email")
  userAgent   String?  @map("user_agent")
  endpoint    String?
  method      String?
  message     String   @db.Text
  details     Json?
  resolved    Boolean  @default(false)
  resolvedAt  DateTime? @map("resolved_at")
  resolvedBy  String?  @map("resolved_by")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([severity, resolved])
  @@index([eventType, createdAt])
  @@index([ipAddress])
  @@map("security_events")
}

// Agent settings for support dashboard
model AgentSettings {
  id                   String        @id @default(uuid())
  userId               String        @unique @map("user_id")
  emailNotifications   Boolean       @default(true) @map("email_notifications")
  soundNotifications   Boolean       @default(true) @map("sound_notifications")
  desktopNotifications Boolean       @default(true) @map("desktop_notifications")
  status               AgentStatus   @default(ONLINE)
  awayMessage          String?       @map("away_message") @db.VarChar(500)
  autoAssign           Boolean       @default(true) @map("auto_assign")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("agent_settings")
}

enum AgentStatus {
  ONLINE
  AWAY
  OFFLINE
}

