generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  SALON_OWNER
  ADMIN // Platform admin (hidden from users)
  SUPPORT // Support staff who can impersonate users
  SUPER_ADMIN // Root admin - full system access
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ProviderCategory {
  BUSINESS    // Salon/Barbershop company
  FREELANCER  // Individual barber/hairdresser
}

enum SalonType {
  BARBERSHOP
  HAIR_SALON
  PEDICURE_SALON
  NAIL_SALON
  SPA
  BEAUTY_SALON
}

enum SalonStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  REFUNDED
}

enum PaymentProvider {
  MTN_MOMO
  VODAFONE_CASH
  AIRTELTIGO_MONEY
  CASH
  PAYSTACK // Paystack (supports cards + mobile money)
}

enum NotificationType {
  BOOKING_CREATED
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  BOOKING_REMINDER
  BOOKING_COMPLETED
  PAYMENT_RECEIVED
  PAYMENT_FAILED
  CHECKIN
  REVIEW
  PROMOTION
  SYSTEM
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  EXPIRED
  PAST_DUE
  PENDING_PAYMENT
}

enum BillingPeriod {
  MONTHLY
  YEARLY
}

enum InvoiceStatus {
  PENDING
  PAID
  FAILED
}

model User {
  id          String     @id @default(uuid())
  phoneNumber String?    @unique @map("phone_number")
  password    String?
  firstName   String     @map("first_name")
  lastName    String     @map("last_name")
  email       String?    @unique
  avatar      String?
  role        UserRole   @default(CUSTOMER)
  status      UserStatus @default(ACTIVE)
  isVerified  Boolean    @default(false) @map("is_verified")

  // Impersonation support
  impersonatedBy String? @map("impersonated_by") // ID of support staff who impersonated this user

  // Location
  latitude     Float?
  longitude    Float?
  address      String?
  ghanaPostGPS String? @map("ghana_post_gps")
  city         String?
  region       String?

  // Timestamps
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  lastLoginAt DateTime? @map("last_login_at")

  // Relations
  salons                  Salon[]
  bookings                Booking[]             @relation("CustomerBookings")
  reviews                 Review[]
  favorites               Favorite[]
  favoriteStaff           FavoriteStaff[]       @relation("FavoriteStaffUser")
  notifications           Notification[]
  payments                Payment[]
  impersonationLogs       ImpersonationLog[]    @relation("ImpersonatedBy")
  performedImpersonations ImpersonationLog[]    @relation("PerformedBy")
  adminPermission         AdminPermission?
  activities              UserActivity[]
  salonQueues             SalonQueue[]
  tickets                 SupportTicket[]       @relation("UserTickets")
  assignedTickets         SupportTicket[]       @relation("AssignedTickets")
  ticketMessages          TicketMessage[]
  groupPaymentsPaidBy     GroupBookingPayment[] @relation("GroupPaymentsPaidBy")
  customerEscrows         EscrowAccount[]       @relation("CustomerEscrows")
  providerEscrows         EscrowAccount[]       @relation("ProviderEscrows")
  providerPenalties       ProviderPenalty[]     @relation("ProviderPenalties")
  noShowRecords           NoShowRecord[]        @relation("NoShowRecords")
  policiesUpdated         PlatformPolicy[]      @relation("PolicyUpdatedBy")
  completionReminders     CompletionReminder[]
  sponsoredSalons         SponsoredSalon[]
  agentSettings           AgentSettings?

  // No-show tracking
  noShowCount       Int       @default(0) @map("no_show_count")
  accountRestricted Boolean   @default(false) @map("account_restricted")
  restrictedUntil   DateTime? @map("restricted_until")

  // Preferences & Onboarding
  preferredCategories String[] @map("preferred_categories")
  onboardingComplete  Boolean  @default(false) @map("onboarding_complete")

  // Relations
  loyaltyAccount  LoyaltyAccount? @relation("CustomerLoyalty")
  waitlistEntries Waitlist[]      @relation("CustomerWaitlist")

  @@index([phoneNumber])
  @@index([role])
  @@index([status])
  @@map("users")
}

model Salon {
  id           String      @id @default(uuid())
  businessName String      @map("business_name")
  description  String?
  type             SalonType
  providerCategory ProviderCategory @default(BUSINESS) @map("provider_category")
  status           SalonStatus @default(PENDING)

  // Registration
  registrationNumber String? @map("registration_number")

  // Contact
  phoneNumber String  @map("phone_number")
  email       String?
  website     String?

  // Location
  address      String
  ghanaPostGPS String? @map("ghana_post_gps")
  city         String
  region       String  @default("Greater Accra")
  latitude     Float?
  longitude    Float?

  // Media
  logo       String?
  coverImage String?  @map("cover_image")
  images     String[]

  // Service Areas (for freelancers - neighborhoods they cover)
  serviceAreas String[] @default([]) @map("service_areas")

  // Business Hours
  openingTime    String   @map("opening_time")
  closingTime    String   @map("closing_time")
  workingDays    String[] @map("working_days")
  operatingHours Json?    @map("operating_hours") // Detailed per-day hours

  // Features
  hasParking     Boolean @default(false) @map("has_parking")
  hasWifi        Boolean @default(false) @map("has_wifi")
  hasAC          Boolean @default(false) @map("has_ac")
  acceptsWalkIns Boolean @default(true) @map("accepts_walk_ins")
  isFeatured     Boolean @default(false) @map("is_featured")

  // Capacity Management
  maxConcurrentClients Int    @default(1) @map("max_concurrent_clients")
  totalChairs          Int    @default(1) @map("total_chairs")
  bufferTimeMinutes    Int    @default(15) @map("buffer_time_minutes")
  operatingModel       String @default("appointment_only") @map("operating_model") // 'appointment_only' or 'walkins_allowed'

  // Payouts
  payoutType            String? @map("payout_type") // 'bank' or 'mobile_money'
  bankCode              String? @map("bank_code") // Paystack bank code
  bankAccountNumber     String? @map("bank_account_number") // Account number
  bankAccountName       String? @map("bank_account_name") // Account holder name
  momoProvider          String? @map("momo_provider") // 'mtn', 'vod', 'tgo'
  momoNumber            String? @map("momo_number") // Phone number
  paystackRecipientCode String? @map("paystack_recipient_code")
  hubtelRecipientId     String? @map("hubtel_recipient_id")

  // Ratings
  rating      Float @default(0)
  reviewCount Int   @default(0) @map("review_count")

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  ownerId        String          @map("owner_id")
  owner          User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  workers        Worker[]
  services       Service[]
  bookings       Booking[]
  reviews        Review[]
  favorites      Favorite[]
  documents      Document[]
  kycSubmission  KycSubmission?
  salonQueues    SalonQueue[]
  escrowAccounts EscrowAccount[]

  // Sponsorship
  isSponsored          Boolean   @default(false)
  sponsorshipPriority  Int       @default(0)
  sponsorshipExpiresAt DateTime?
  sponsorships         SponsoredSalon[]

  // Service Completion Settings
  autoCompletionHours            Int     @default(2) @map("auto_completion_hours")
  requiresCustomerConfirmation   Boolean @default(false) @map("requires_customer_confirmation")
  completionReminderEnabled      Boolean @default(true) @map("completion_reminder_enabled")
  qrCheckinEnabled               Boolean @default(true) @map("qr_checkin_enabled")

  // Branding & Waitlist
  slug            String?      @unique
  waitlistEntries Waitlist[]
  brandedPage     BrandedPage?

  // Subscription
  subscriptionId        String?
  subscriptionStatus    String    @default("free")
  subscriptionExpiresAt DateTime?
  featureFlags          Json      @default("{}")

  // Subscription Relations
  activeSubscription    SalonSubscription?  @relation("ActiveSubscription", fields: [subscriptionId], references: [id])
  subscriptions         SalonSubscription[] @relation("SalonSubscriptions")
  subscriptionInvoices  SubscriptionInvoice[]
  featureUsages         FeatureUsage[]

  @@index([ownerId])
  @@index([type])
  @@index([providerCategory])
  @@index([status])
  @@index([city])
  @@index([latitude, longitude])
  @@map("salons")
}

model Worker {
  id          String   @id @default(uuid())
  fullName    String   @map("full_name")
  phoneNumber String?  @map("phone_number")
  email       String?
  bio         String?
  avatar      String?
  specialties String[]

  // Experience
  yearsOfExperience Int @default(0) @map("years_of_experience")

  // Stats
  rating        Float @default(0)
  reviewCount   Int   @default(0) @map("review_count")
  totalBookings Int   @default(0) @map("total_bookings")

  // Status
  isActive  Boolean @default(true) @map("is_active")
  isOnLeave Boolean @default(false) @map("is_on_leave")

  // Capacity
  concurrentCapacity Int @default(1) @map("concurrent_capacity")

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  salonId        String          @map("salon_id")
  salon          Salon           @relation(fields: [salonId], references: [id], onDelete: Cascade)
  bookings       Booking[]
  availabilities Availability[]
  reviews        Review[]
  workerServices WorkerService[]
  favoritedBy    FavoriteStaff[]
  salonQueues    SalonQueue[]
  bookingGuests  BookingGuest[]

  @@index([salonId])
  @@map("workers")
}

model WorkerService {
  workerId      String   @map("worker_id")
  worker        Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  serviceId     String   @map("service_id")
  service       Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  priceOverride Decimal? @map("price_override") @db.Decimal(10, 2)

  @@id([workerId, serviceId])
  @@index([workerId])
  @@index([serviceId])
  @@map("worker_services")
}

model Service {
  id            String   @id @default(uuid())
  name          String
  description   String?
  category      String
  duration      Int // in minutes
  price         Decimal  @db.Decimal(10, 2)
  discountPrice Decimal? @map("discount_price") @db.Decimal(10, 2)
  promoLabel    String?  @map("promo_label") // e.g., "20% OFF", "Summer Special"
  image         String?
  isActive          Boolean  @default(true) @map("is_active")
  offersHomeService  Boolean  @default(false) @map("offers_home_service")
  homeServiceFee     Decimal? @map("home_service_fee") @db.Decimal(10, 2)

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  salonId        String          @map("salon_id")
  salon          Salon           @relation(fields: [salonId], references: [id], onDelete: Cascade)
  bookings       Booking[]
  workerServices WorkerService[]
  salonQueues    SalonQueue[]
  bookingGuests  BookingGuest[]

  @@index([salonId])
  @@index([category])
  @@map("services")
}

model Booking {
  id        String        @id @default(uuid())
  reference String        @unique @default(dbgenerated("'GL-' || substr(md5(random()::text), 1, 8)"))
  status    BookingStatus @default(PENDING)

  // Date & Time
  date      DateTime
  startTime String   @map("start_time")
  endTime   String   @map("end_time")

  // Pricing
  totalAmount    Decimal  @map("total_amount") @db.Decimal(10, 2)
  discountAmount Decimal? @map("discount_amount") @db.Decimal(10, 2)
  finalAmount    Decimal  @map("final_amount") @db.Decimal(10, 2)

  // Notes
  customerNotes String? @map("customer_notes")
  salonNotes    String? @map("salon_notes")

  // Booking hold and reminder tracking
  holdExpiresAt DateTime? @map("hold_expires_at")
  reminderSent  Boolean   @default(false) @map("reminder_sent")

  // Group Booking Support
  isGroupBooking    Boolean @default(false) @map("is_group_booking")
  totalPeople       Int     @default(1) @map("total_people")
  groupBookingRef   String? @map("group_booking_ref")
  primaryCustomerId String? @map("primary_customer_id")
  billingType       String  @default("combined") @map("billing_type") // 'combined' or 'separate'

  // Escrow and Trust
  refundEligible       Boolean   @default(true) @map("refund_eligible")
  refundPercentage     Decimal?  @map("refund_percentage") @db.Decimal(5, 2)
  cancellationDeadline DateTime? @map("cancellation_deadline")
  providerCancelled    Boolean   @default(false) @map("provider_cancelled")
  noShowFlag           Boolean   @default(false) @map("no_show_flag")

  // Timestamps
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  confirmedAt DateTime? @map("confirmed_at")
  completedAt DateTime? @map("completed_at")
  cancelledAt DateTime? @map("cancelled_at")

  // Relations
  customerId          String                @map("customer_id")
  customer            User                  @relation("CustomerBookings", fields: [customerId], references: [id], onDelete: Cascade)
  salonId             String                @map("salon_id")
  salon               Salon                 @relation(fields: [salonId], references: [id])
  workerId            String?               @map("worker_id")
  worker              Worker?               @relation(fields: [workerId], references: [id])
  serviceId           String                @map("service_id")
  service             Service               @relation(fields: [serviceId], references: [id])
  payment             Payment?
  review              Review?
  guests              BookingGuest[]
  groupPayments       GroupBookingPayment[]
  escrow              EscrowAccount?
  cancellationRecords CancellationRecord[]
  providerPenalties   ProviderPenalty[]
  noShowRecords       NoShowRecord[]

  // Service Completion
  serviceCompleted        Boolean   @default(false) @map("service_completed")
  serviceCompletedAt      DateTime? @map("service_completed_at")
  serviceCompletedBy      String?   @map("service_completed_by")
  completionMethod        String?   @map("completion_method") // 'manual', 'auto', 'qr_scan', 'customer_confirmation', 'admin_resolution'
  autoCompletionAttempts  Int       @default(0) @map("auto_completion_attempts")
  autoCompletionDeadline  DateTime? @map("auto_completion_deadline")
  customerConfirmed       Boolean   @default(false) @map("customer_confirmed")
  customerConfirmedAt     DateTime? @map("customer_confirmed_at")
  disputeRaised           Boolean   @default(false) @map("dispute_raised")
  disputeReason           String?   @map("dispute_reason")
  completionReminders     CompletionReminder[]

  // Check-in fields
  checkedIn           Boolean   @default(false)
  checkedInAt         DateTime?
  checkedInBy         String?
  checkinCode         String?   @unique
  queuePosition       Int?
  queueEntryId        String?

  // Hubtel
  hubtelInvoiceReference String? @map("hubtel_invoice_reference")

  // Payment failure tracking
  paymentFailedReason String?   @map("payment_failed_reason")
  paymentRetryCount   Int       @default(0) @map("payment_retry_count")

  @@index([customerId])
  @@index([salonId])
  @@index([workerId])
  @@index([status])
  @@index([date])
  @@index([salonId, date, status])
  @@index([groupBookingRef])
  @@map("bookings")
}

model BookingGuest {
  id                  String    @id @default(uuid())
  bookingId           String    @map("booking_id")
  booking             Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  guestName           String    @map("guest_name")
  guestPhone          String?   @map("guest_phone")
  guestAgeGroup       String?   @map("guest_age_group") // 'child', 'teen', 'adult', 'senior'
  serviceId           String    @map("service_id")
  service             Service   @relation(fields: [serviceId], references: [id])
  staffId             String?   @map("staff_id")
  staff               Worker?   @relation(fields: [staffId], references: [id])
  priceAmount         Decimal?  @map("price_amount") @db.Decimal(10, 2)
  specialInstructions String?   @map("special_instructions")
  isChild             Boolean   @default(false) @map("is_child")
  status              String    @default("PENDING") @map("status") // PENDING, CHECKED_IN, CANCELLED, NO_SHOW
  checkedIn           Boolean   @default(false) @map("checked_in")
  checkedInAt         DateTime? @map("checked_in_at")
  cancelledAt         DateTime? @map("cancelled_at")
  cancelledBy         String?   @map("cancelled_by") // userId who cancelled
  cancelReason        String?   @map("cancel_reason")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  // Relations
  payments GroupBookingPayment[]

  @@index([bookingId])
  @@map("booking_guests")
}

model GroupBookingPayment {
  id                       String        @id @default(uuid())
  bookingId                String        @map("booking_id")
  booking                  Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  guestId                  String?       @map("guest_id")
  guest                    BookingGuest? @relation(fields: [guestId], references: [id])
  amount                   Decimal       @db.Decimal(10, 2)
  paymentStatus            String        @default("pending") @map("payment_status")
  mobileMoneyTransactionId String?       @map("mobile_money_transaction_id")
  paidByUserId             String?       @map("paid_by_user_id")
  paidBy                   User?         @relation("GroupPaymentsPaidBy", fields: [paidByUserId], references: [id])
  paidAt                   DateTime?     @map("paid_at")
  createdAt                DateTime      @default(now()) @map("created_at")

  @@index([bookingId])
  @@map("group_booking_payments")
}

model Payment {
  id       String          @id @default(uuid())
  provider PaymentProvider
  amount   Decimal         @db.Decimal(10, 2)
  currency String          @default("GHS")
  status   PaymentStatus   @default(PENDING)

  // Provider specific
  providerRef         String? @map("provider_ref")
  providerData        Json?   @map("provider_data")
  hubtelTransactionId String? @map("hubtel_transaction_id")
  paystackTransactionId String? @map("paystack_transaction_id")
  paystackAccessCode  String? @map("paystack_access_code")
  
  // Multi-provider tracking
  paymentGateway      String? @map("payment_gateway") // 'hubtel', 'paystack'
  gatewayTransactionId String? @map("gateway_transaction_id")

  // Timestamps
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  completedAt DateTime? @map("completed_at")

  // Relations
  bookingId String  @unique @map("booking_id")
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  userId    String  @map("user_id")
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([paymentGateway])
  @@map("payments")
}

model Review {
  id      String  @id @default(uuid())
  rating  Int // 1-5
  comment String?

  // Salon reply
  salonReply     String?   @map("salon_reply")
  salonRepliedAt DateTime? @map("salon_replied_at")

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  customerId String  @map("customer_id")
  customer   User    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  salonId    String  @map("salon_id")
  salon      Salon   @relation(fields: [salonId], references: [id], onDelete: Cascade)
  workerId   String? @map("worker_id")
  worker     Worker? @relation(fields: [workerId], references: [id], onDelete: SetNull)
  bookingId  String  @unique @map("booking_id")
  booking    Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([salonId])
  @@index([workerId])
  @@index([customerId])
  @@map("reviews")
}

model Favorite {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  userId  String @map("user_id")
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  salonId String @map("salon_id")
  salon   Salon  @relation(fields: [salonId], references: [id], onDelete: Cascade)

  @@unique([userId, salonId])
  @@index([userId])
  @@map("favorites")
}

model FavoriteStaff {
  userId    String   @map("user_id")
  user      User     @relation("FavoriteStaffUser", fields: [userId], references: [id], onDelete: Cascade)
  workerId  String   @map("worker_id")
  worker    Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@id([userId, workerId])
  @@index([userId])
  @@index([workerId])
  @@map("favorite_staff")
}

model Availability {
  id          String  @id @default(uuid())
  dayOfWeek   Int     @map("day_of_week") // 0-6 (Sunday-Saturday)
  startTime   String  @map("start_time") // HH:mm format
  endTime     String  @map("end_time") // HH:mm format
  isAvailable Boolean @default(true) @map("is_available")
  isClosed    Boolean @default(false) @map("is_closed")

  // Break time fields
  isBreakSlot Boolean @default(false) @map("is_break_slot")
  breakStart  String? @map("break_start") // HH:mm format
  breakEnd    String? @map("break_end") // HH:mm format

  // Specific date overrides (for holidays, time off)
  specificDate DateTime? @map("specific_date")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  workerId String @map("worker_id")
  worker   Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([workerId])
  @@index([dayOfWeek])
  @@map("availabilities")
}

model Document {
  id       String  @id @default(uuid())
  type     String // business_license, id_proof, etc.
  name     String
  url      String
  verified Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  salonId String @map("salon_id")
  salon   Salon  @relation(fields: [salonId], references: [id], onDelete: Cascade)

  @@index([salonId])
  @@map("documents")
}

model KycSubmission {
  id             String @id @default(uuid())
  salonId        String @unique
  salon          Salon  @relation(fields: [salonId], references: [id])
  businessType   String // "REGISTERED_COMPANY" or "INDIVIDUAL"
  ownerLegalName String

  // Registered Company fields
  businessRegName    String?
  tinNumber          String?
  registrationNumber String?

  // Document URLs (stored in Cloudinary)
  governmentIdUrl    String?
  selfieWithIdUrl    String?
  storefrontVideoUrl String?
  interiorVideoUrl   String?
  businessCertUrl    String? // Company only
  proofOfAddressUrl  String? // Individual only

  // Status
  status          String    @default("PENDING") // PENDING, APPROVED, REJECTED
  rejectionReason String?
  reviewedBy      String?
  reviewedAt      DateTime?
  submittedAt     DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([salonId])
  @@index([status])
}

model Notification {
  id      String           @id @default(uuid())
  type    NotificationType
  title   String
  message String
  data    Json?
  isRead  Boolean          @default(false) @map("is_read")

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

model Otp {
  id          String   @id @default(uuid())
  phoneNumber String?  @map("phone_number")
  email       String?
  code        String
  expiresAt   DateTime @map("expires_at")
  verified    Boolean  @default(false)
  attempts    Int      @default(0)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([phoneNumber])
  @@index([email])
  @@index([expiresAt])
  @@map("otps")
}

model Coupon {
  id            String    @id @default(uuid())
  code          String    @unique
  discountType  String    @map("discount_type") // percentage, fixed
  discountValue Decimal   @map("discount_value") @db.Decimal(10, 2)
  validFrom     DateTime? @map("valid_from")
  validUntil    DateTime? @map("valid_until")
