model SupportTicket {
  id          String                @id @default(uuid())
  subject     String
  description String
  status      SupportTicketStatus   @default(OPEN)
  priority    SupportTicketPriority @default(MEDIUM)
  category    String?
  source      TicketSource          @default(OTHER)

  // Guest fields (used when userId is null - landing-page anonymous visitors)
  guestEmail String? @map("guest_email")
  guestName  String? @map("guest_name")

  // Unread counters for live chat
  unreadByAgent Int @default(0) @map("unread_by_agent")
  unreadByUser  Int @default(0) @map("unread_by_user")

  // Relations
  userId       String?         @map("user_id")
  user         User?           @relation("UserTickets", fields: [userId], references: [id], onDelete: Cascade)
  assignedToId String?         @map("assigned_to_id")
  assignedTo   User?           @relation("AssignedTickets", fields: [assignedToId], references: [id], onDelete: SetNull)
  messages     TicketMessage[]

  // Timestamps
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  lastMessageAt DateTime @default(now()) @map("last_message_at")

  @@index([userId])
  @@index([assignedToId])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
  @@index([lastMessageAt])
  @@index([source, status])
  @@map("support_tickets")
}

model TicketMessage {
  id         String  @id @default(uuid())
