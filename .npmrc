# pnpm monorepo configuration for EAS Build compatibility
# Use hoisted node_modules (flat structure like npm)
# Required for React Native / Expo - Gradle can't resolve pnpm symlinks
node-linker=hoisted
shamefully-hoist=true

# Ensure Expo packages are hoisted for plugin resolution
public-hoist-pattern[]=*expo*
public-hoist-pattern[]=@expo/*
public-hoist-pattern[]=expo-modules-autolinking

# Allow peer dependency mismatches (common in RN ecosystem)
legacy-peer-deps=true
# pnpm monorepo configuration
# Use hoisted node_modules (flat structure like npm)
# Required for React Native / Expo - Gradle can't resolve pnpm symlinks
node-linker=hoisted

# pnpm hoisting for Expo monorepo compatibility
public-hoist-pattern[]=*expo*
public-hoist-pattern[]=@expo/*
public-hoist-pattern[]=expo-modules-autolinking
shamefully-hoist=true
# Disable npm workspaces - this project uses pnpm
workspaces=false
legacy-peer-deps=true

# Use hoisted node_modules (flat structure like npm)
# Required for React Native / Expo - Gradle can't resolve pnpm symlinks
node-linker=hoisted

# pnpm hoisting for Expo monorepo compatibility
public-hoist-pattern[]=expo-modules-autolinking
public-hoist-pattern[]=@expo/*
shamefully-hoist=true
