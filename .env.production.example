# Production Environment Configuration
NODE_ENV=production
PORT=3000

# Database (Use strong passwords in production)
DB_USER=groomlink_prod
DB_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD
DB_NAME=groomlink_prod
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@postgres:5432/${DB_NAME}

# Redis
REDIS_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379

# JWT (Generate a strong random secret)
JWT_SECRET=CHANGE_THIS_TO_64_CHAR_RANDOM_STRING
JWT_EXPIRES_IN=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Database Pool Settings (Higher for production)
DB_CONNECTION_POOL_SIZE=50
DB_CONNECTION_TIMEOUT=30000
DB_IDLE_TIMEOUT=60000

# SMS Provider
SMS_PROVIDER=africas_talking
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Africa's Talking
AT_API_KEY=your-at-api-key
AT_USERNAME=your-at-username
AT_SENDER_ID=GroomLink

# SMTP Email Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user@example.com
SMTP_PASSWORD=your-smtp-password
EMAIL_FROM=noreply@groomlink.com

# Hubtel Payment
HUBTEL_API_ID=your_hubtel_api_id
HUBTEL_API_SECRET=your_hubtel_api_secret
HUBTEL_MERCHANT_ACCOUNT_ID=your_hubtel_merchant_account_id
HUBTEL_PAYMENT_WEBHOOK_URL=https://groomlinkgh.com/api/payments/webhook/hubtel

# CORS (Restrict to your domain)
CORS_ORIGIN=https://groomlink.com,https://www.groomlink.com

# Admin Dashboard
ADMIN_URL=https://admin.groomlink.com

# Monitoring & Logging
LOG_LEVEL=info
SENTRY_DSN=

# Backup
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *

# Booking Engine
BOOKING_BUFFER_MINUTES=15
CANCELLATION_GRACE_HOURS=3
MAX_BOOKING_DAYS_AHEAD=30
HOLD_DURATION_SECONDS=600
AUTO_CANCEL_UNPAID_MINUTES=30
RESCHEDULE_FEE_GHES=5
RESCHEDULE_FEE_WINDOW_HOURS=24

# Google Maps
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
