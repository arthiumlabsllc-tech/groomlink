# GroomLink Mobile App Environment Variables
# Copy this file to .env in each app directory (customer-app and partners-app)

# Google Maps API Key (from VPS production)
# Get this value from your VPS: docker exec groomlink-api printenv GOOGLE_MAPS_API_KEY
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Customer Web App (optional - automatically fetched from API config at runtime)
# VITE_GOOGLE_MAPS_API_KEY=${GOOGLE_MAPS_API_KEY}

# API URLs
EXPO_PUBLIC_API_URL=https://groomlinkgh.com/api
EXPO_PUBLIC_WS_URL=https://groomlinkgh.com

# Other configuration can be added here
