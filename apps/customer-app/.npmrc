# pnpm settings for EAS build compatibility in pnpm monorepo
node-linker=hoisted
shamefully-hoist=true

# Hoist Expo packages so EAS plugin resolver can find them
public-hoist-pattern[]=*expo*
public-hoist-pattern[]=@expo/*
public-hoist-pattern[]=expo-modules-autolinking
# pnpm settings for EAS build compatibility in pnpm monorepo
node-linker=hoisted
shamefully-hoist=true

# Hoist Expo packages so EAS plugin resolver can find them
public-hoist-pattern[]=*expo*
public-hoist-pattern[]=@expo/*
public-hoist-pattern[]=expo-modules-autolinking

# Allow peer dependency mismatches
legacy-peer-deps=true
