# .easignore for customer-app
# EAS uploads the entire monorepo; this file excludes unnecessary content.
# IMPORTANT: pnpm-lock.yaml, pnpm-workspace.yaml, root package.json, and
# root .npmrc must NOT be ignored — EAS needs them for pnpm install.

# Other monorepo apps (not needed for this build)
apps/admin/
apps/customer/
apps/landing/
apps/mobile/
apps/partners/
apps/partners-app/
apps/support/

# Backend services and shared packages (not needed for mobile build)
services/
packages/

# Non-essential root files
.github/
.idea/
.vscode/
.venv/
nginx/
*.py
*.ps1
*.psd
*.bin
*.txt
*.log

# Environment and config files
.env*
docker-compose*.yml
codemagic.yaml
app.json

# Docs at root
*.md

# Native build artifacts (already in .gitignore but be explicit)
android-sdk/
.gradle/

# EAS internal
.eas/
