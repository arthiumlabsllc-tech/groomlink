# EAS Build needs monorepo context to install dependencies correctly.
# DO NOT ignore these root files (EAS needs them for pnpm monorepo detection):
#   - pnpm-workspace.yaml
#   - pnpm-lock.yaml
#   - package.json (root)

# Ignore other monorepo app directories (not needed for this app's build)
../apps/admin
../apps/customer
../apps/customer-app
../apps/landing
../apps/mobile
../apps/partners
../apps/support
../services
../packages

# Ignore non-essential root files
../.gitignore
../.github
../.idea
../.vscode
../.venv
../nginx
../.env*
../app.json
../codemagic.yaml
../docker-compose*.yml

# Ignore root-level noise (Python scripts, images, docs, etc.)
*.md
*.py
*.png
*.psd
*.bin
*.txt
backup.sh
deploy.sh
hostinger-*
*.example

# Native build directories and large SDK files - never upload to EAS
android-sdk/
../android-sdk/
android/
ios/
.gradle/
