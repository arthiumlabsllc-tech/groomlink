{
  "expo": {
    "name": "GroomLink Partners",
    "slug": "groomlink-partners",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#006B3F"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.arthiumlabs.partners",
      "buildNumber": "1.0.0",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "GroomLink Partners uses your location for your salon address.",
        "NSCameraUsageDescription": "GroomLink Partners needs camera access to upload salon photos.",
        "NSPhotoLibraryUsageDescription": "GroomLink Partners needs photo library access to upload salon photos.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.arthiumlabs.partners",
      "versionCode": 1,
      "minSdkVersion": 24,
      "targetSdkVersion": 35,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#006B3F"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "POST_NOTIFICATIONS",
        "FOREGROUND_SERVICE",
        "RECEIVE_BOOT_COMPLETED",
        "SCHEDULE_EXACT_ALARM",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "0c94a806-7dcb-42fe-935f-8c577b83e053"
      }
    },
    "plugins": [
      "./plugins/expo-sdk-fix",
          [
            "expo-build-properties",
            {
              "android": {
                "compileSdkVersion": 35,
                "targetSdkVersion": 35,
                "minSdkVersion": 24,
                "ndkVersion": "26.1.10909125"
              }
            }
          ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#006B3F"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "GroomLink Partners needs your location to set your salon's position on the map."
        }
      ],
      "./plugins/android-manifest-fixes"
    ],
    "owner": "gr3enink"
  }
}
