{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/payment/callback/:path*",
      "destination": "https://my.groomlinkgh.com/payment/callback/:path*",
      "permanent": true
    },
    {
      "source": "/payment/callback",
      "destination": "https://my.groomlinkgh.com/payment/callback",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api.groomlinkgh.com/api/:path*"
    },
    {
      "source": "/socket.io/:path*",
      "destination": "https://api.groomlinkgh.com/socket.io/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
