{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api.groomlinkgh.com/api/:path*"
    },
    {
      "source": "/socket.io/:path*",
      "destination": "https://api.groomlinkgh.com/socket.io/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
